Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 110; 110; 110
    - Class: rviz_default_plugins/PointCloud2
      Name: World scan
      Enabled: true
      Topic:
        Value: /cloud_world
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: Intensity
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Topic:
        Value: /path
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 255; 85; 0
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odometry
        Depth: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Arrow
      Position Tolerance: 0.2
      Angle Tolerance: 0.2
      Keep: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Voxel planes (enable publishing in config)
      Enabled: false
      Topic:
        Value: /voxel_planes
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Width: 1440
  Height: 900
